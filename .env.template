# CoT Faithfulness Research — API key template.
#
# SETUP: copy this file to `.env` (which is gitignored) and paste in your real
# keys. Never commit `.env`, and never print/log key values (ground rule 7).
#
#     cp .env.template .env
#
# You only need keys for the providers you actually call. The workhorse and
# panel are chosen from the Phase 0 capability matrix, so leave unused keys blank.

# OpenAI (GPT-5.4 / GPT-5.4-mini)
OPENAI_API_KEY=

# Anthropic (Claude Sonnet 4.6, etc.)
ANTHROPIC_API_KEY=

# Google Gemini (Gemini 3 Flash)
GEMINI_API_KEY=

# OpenRouter (GLM-5.2, DeepSeek-R1-Distill-Qwen-7B, ...) — OpenAI-compatible endpoint
OPENROUTER_API_KEY=

# Together AI (open-weight models) — OpenAI-compatible endpoint
TOGETHER_API_KEY=
